{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "defaultPalette": false,
            "background": true,
            "text": true,
            "link": true,
            "custom": true,
            "customDuotone": true,
            "customGradient": true,
            "palette": [
                { "slug": "primary", "color": "#ff6b35", "name": "金玉主色" },
                { "slug": "primary-dark", "color": "#e85a2b", "name": "主色·深" },
                { "slug": "success", "color": "#00b74a", "name": "成功" },
                { "slug": "warning", "color": "#fc651f", "name": "警告" },
                { "slug": "danger", "color": "#dc3545", "name": "危险" },
                { "slug": "info", "color": "#17a2b8", "name": "信息" },
                { "slug": "background", "color": "#f5f6f8", "name": "背景" },
                { "slug": "card", "color": "#ffffff", "name": "卡片背景" },
                { "slug": "foreground", "color": "#1a1d21", "name": "正文" },
                { "slug": "muted", "color": "#808695", "name": "辅助文字" },
                { "slug": "border", "color": "#eef0f3", "name": "边框" },
                { "slug": "border-strong", "color": "#dde0e5", "name": "边框·强" }
            ]
        },
        "typography": {
            "customFontSize": true,
            "lineHeight": true,
            "fontFamilies": [
                {
                    "slug": "system",
                    "name": "系统默认",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif"
                }
            ],
            "fontSizes": [
                { "slug": "small", "size": "0.875rem", "name": "小" },
                { "slug": "medium", "size": "1rem", "name": "常规" },
                { "slug": "large", "size": "1.25rem", "name": "大" },
                { "slug": "x-large", "size": "1.5rem", "name": "特大" },
                { "slug": "xx-large", "size": "2rem", "name": "超大" }
            ]
        },
        "layout": {
            "contentSize": "1240px",
            "wideSize": "1920px"
        },
        "spacing": {
            "units": ["px", "em", "rem", "vh", "vw", "%"],
            "spacingScale": {
                "steps": 7,
                "mediumStep": 1.5,
                "unit": "rem"
            }
        },
        "blocks": {
            "core/button": { "border": { "radius": true } },
            "core/quote": { "border": { "color": true, "style": true, "width": true } },
            "core/post-title": { "typography": { "lineHeight": true } }
        }
    },
    "styles": {}
}
