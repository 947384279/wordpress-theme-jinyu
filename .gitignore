# ============================================================
# jinyu 主题 - Git 忽略规则
# 构建产物 / 依赖 / 打包文件 / 本地凭证与运营资料不进入版本库
# ============================================================

# 构建产物：dist 已编译并随仓库发布，保证 git clone 即可安装
# 若只想跟踪源码、由 CI 构建 dist，可改回 /assets/dist/

# Node 依赖
/node_modules/
npm-debug.log*
yarn-error.log

# 打包 / 归档
*.zip
*.tar.gz

# 私有更新与运营配置（非主题源）
jinyu-update.json

# 本地工作笔记与运营文档（非项目源）
memory/
博客流量增长方案.md
定时发布排期表.md
站长平台收录优化清单.md
长尾选题矩阵.md

# 操作系统 / 编辑器临时文件
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*~

# 本地开发环境快照与凭证文件（非项目源）
.workbuddy/
.trae/

# 后端私有配置（独立仓库，非项目源）
config.local.php

# 发布与调试过程中间产物（非项目源）
# w.org 发行变体构建产物（单真源策略：源码始终保留设置页，此目录为生成物）
/dist-wporg/
/release/
jinyu-theme-intro.html
jinyu-theme-post.html
jinyu-intro-assets/
.shot-tools/
lighthouse-report/
brand-design/
_tmp_mem.py
_tmp_*.py
sshrun*.py
sftp*.py

# 内部文档与设计稿（非项目源，禁止公开发布）
jinyu-bug-report.md
jinyu-plugin-preview.html

# 本地设计审计产物（截图/预览/测试脚本，非主题源）
_design_audit/

# 一次性调试输出（jy_*_out.html / jy_*_trace.log 之类），
# 是探针 echo 的结果快照（含线上路径、水印配置等运行态信息），绝不能进包或进库
jy_*_out.html
jy_*_out.txt
jy_*_trace.log
jy_probe_*.html

# 顶栏设置页视觉预览原型（非主题源，无引用）
/topbar-preview.html

# FontAwesome 图标子集化中间产物（fa-collect.py 可重新生成，非主题源）
# 注意：icons.extra.txt 是手工维护的白名单，必须保留在版本库中
/assets/fonts/fa/icons.all.raw.txt
/assets/fonts/fa/icons.raw.txt
/assets/fonts/fa/icons.map.json

# w.org / wpcom 主题目录 RSS 抓取样本（tag 校验用，可重新下载，非主题源）
wporg_feed.xml
wpcom_feed.xml
