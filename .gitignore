# 操作系统 / 编辑器临时文件
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*~

# 本地开发环境快照与凭证文件（非项目源）
.workbuddy/
.trae/

# 后端私有配置（独立仓库，非项目源）
config.local.php

# 发布与调试过程中间产物（非项目源）
